// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  /// Editable default texts and toggles for new campaigns and offers.
  /// Shape and validation: lib/campaigns/message-defaults.ts. Null until seeded.
  messageDefaults   Json?

  zernioConnection  ZernioConnection?
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  serviceKeys       ServiceKey[]
  contacts          Contact[]
  contactTags       ContactTag[]
  offers            Offer[]
  contactOffers     ContactOffer[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model ServiceKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  tokenHash   String    @unique
  scopes      String[]
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  provider          InstagramProvider @default(META)
  /// Which Meta setup issued the token, for META accounts. Existing rows are
  /// INSTAGRAM: their tokens only work on graph.instagram.com. UNIFIED tokens
  /// are business system user tokens that only work on graph.facebook.com.
  metaLogin         MetaLogin @default(INSTAGRAM)
  zernioAccountId   String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // The connection check (A1, lib/instagram/connection-check.ts). With every
  // comment sweep the worker reads the account's own node once. A token or
  // permission error, or Meta no longer finding the account (100/33), is a
  // "lost" check; two of them at least one sweep interval apart open an
  // incident, and one check that gets through (or a reconnect) ends it.

  /// The first "lost" check of the current run. Cleared by a check that gets
  /// through and by a reconnect.
  connectionCheckFailedAt DateTime?
  /// Open incident: since when the connection is lost, which is the time of
  /// that first "lost" check. Null while the connection works.
  connectionLostAt        DateTime?
  /// Why, short and never a token: "<token|permission|missing> (Meta <code>/<subcode>)".
  connectionLostReason    String?
  /// When the last alert e-mail went out, for any incident of the account: at
  /// most one e-mail per 24 hours. Kept when the incident ends.
  connectionAlertSentAt   DateTime?
  /// E-mails sent for the open incident: 1 after the alert, 2 after the one
  /// reminder. Back to 0 when an incident starts or ends.
  connectionAlertCount    Int       @default(0)
  /// When the last incident ended: a check got through, or a reconnect.
  connectionRecoveredAt   DateTime?
  /// The start of an ended incident whose missed comments are still to be
  /// caught up. Set when an incident ends (the earlier one, if a catch-up is
  /// still pending); the catch-up sets it back to null once it has run.
  connectionCatchUpFrom   DateTime?

  // The catch-up after an incident (A1, lib/instagram/connection-catch-up.ts):
  // once the connection is back, the worker reads the comments of the
  // meantime and queues their DMs, one every 20 seconds.

  /// Held by the catch-up that runs right now, renewed while it reads.
  /// Another run takes over only once it is 10 minutes old (a worker that
  /// died in the middle).
  connectionCatchUpClaimedAt DateTime?
  /// How far a catch-up that stopped early got (an R1 pause, a Meta limit, a
  /// worker restart), so the next run continues there. Null otherwise.
  connectionCatchUpProgress  Json?
  /// The last finished catch-up: the comments it queued, the comments the
  /// owner had answered by hand (not sent), what it skipped. Diagnostics and
  /// the all-clear e-mail show it.
  connectionCatchUpResult    Json?
  /// The all-clear e-mail of the last catch-up is still to go out: the time
  /// that catch-up finished. Null once it went out or was given up.
  connectionAllClearDueAt    DateTime?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]
  contacts    Contact[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)
  // Skip comments whose raw text contains ?, ？, ¿ or ؟ (R9a). Existing rows keep
  // false; new campaigns get true from the API default and the editor.
  ignoreQuestionComments       Boolean  @default(false)
  // Second follow request, sent after the last automatic re-check (R9b).
  // Null falls back to followPromptMessage / followPromptButtonLabel.
  followPromptRetryMessage     String?
  followPromptRetryButtonLabel String?
  // Tag added to the contact when this campaign's link DM is delivered (R2).
  deliveryTag                  String?
  // Weg 2: start a lead-magnet offer after an interaction-backed delivery (R4).
  offersEnabled                Boolean  @default(false)
  // Custom offer order (Offer ids). Empty = workspace default order (R13).
  offerIds                     String[] @default([])
  // When the offer starts after the link: 0 right away, 22 (OFFER_LATE_START_HOURS,
  // lib/offers/schedule.ts) hours after the tap or DM that brought the link, then
  // without a reminder. Only these two values; lib/campaigns/schema.ts checks them.
  offerDelayHours              Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  contactOffers    ContactOffer[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  dmDeliveryUnconfirmed Boolean @default(false)
  publicReplyDeliveryUnconfirmed Boolean @default(false)
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([commenterId])
}

// Legacy reconciliation model; currently unwired. Runtime code does not read
// or write ProcessedComment. Current reconciliation dedup uses owner-reply
// checks and DmLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  // Which DM button this link is, starting at 0. Read links with
  // TRACKED_LINK_ORDER (lib/tracking/link-order.ts), never by createdAt alone:
  // links saved in one request share a createdAt, and Postgres returns tied
  // rows in no fixed order.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  // Token from the link's `?r=` (hashRecipientId), set on links sent in a DM.
  // Clicks are counted once per recipient, falling back to ipHash without it.
  recipientHash      String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, recipientHash])
}

/// One Instagram user as seen by one connected account (R1, R18).
model Contact {
  id                 String    @id @default(cuid())
  workspaceId        String
  /// InstagramAccount row id (as on DmLog), not the Instagram business id.
  instagramAccountId String
  /// Instagram-scoped user id; the comment author id equals the DM sender id.
  igsid              String
  username           String?
  /// hashRecipientId(igsid), the ?r= token on tracked links (lib/tracking/server.ts:19-25).
  /// Stored because the HMAC cannot be reversed; rewritten on every upsert.
  recipientHash      String
  /// Last button tap or inbound DM. Meta's 24 h window counts from here; comments never set it.
  lastInteractionAt  DateTime?
  createdAt          DateTime  @default(now())
  /// Bumped by every upsert ("last seen").
  updatedAt          DateTime  @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  tags             ContactTag[]
  offers           ContactOffer[]

  @@unique([instagramAccountId, igsid])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, recipientHash])
}

/// A free-text tag; createdAt is when it was first set (R2). Tag names are user content.
model ContactTag {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  tag         String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, tag])
  @@index([workspaceId, tag])
}

/// Workspace-level evergreen lead-magnet offer (R3, R13).
model Offer {
  id                        String    @id @default(cuid())
  workspaceId               String
  name                      String
  /// false = paused: skipped when a new offer is chosen.
  isActive                  Boolean   @default(true)
  /// Workspace default order. Read with OFFER_ORDER (position, createdAt, id).
  position                  Int       @default(0)
  /// "Deleted" after it was offered: keeps funnel history and sent card links.
  archivedAt                DateTime?
  /// When it was first started for someone. Kept when the ContactOffer rows go
  /// (disconnecting an account deletes its contacts' offers), so deleting an offer
  /// whose card links may be in someone's inbox archives it instead.
  firstOfferedAt            DateTime?
  /// The last message carries the "Ja, gerne!" button (<= 640 UTF-16 units).
  offerMessages             String[]  @default([])
  /// Seconds to wait before each offer message; same length as offerMessages.
  offerDelaysSeconds        Int[]     @default([])
  offerButtonLabel          String
  confirmationMessages      String[]  @default([])
  confirmationDelaysSeconds Int[]     @default([])
  cardImageUrl              String?
  cardTitle                 String
  cardSubtitle              String?
  cardButtonLabel           String
  /// Target of the card button and the reminder button, served by /o/<linkSlug>.
  destinationUrl            String
  /// Random public slug (generateTrackedLinkSlug), globally unique like TrackedLink.slug.
  linkSlug                  String    @unique
  reminderEnabled           Boolean   @default(true)
  reminderDelayHours        Int       @default(23)
  reminderMessage           String?
  /// Sign-up feedback from the landing page: the card's and the reminder's link
  /// arrive there with ig=<ContactOffer.signupToken>, and the page reports the
  /// sign-up back (POST /api/offers/signup). Off: the link stays as typed.
  signupTrackingEnabled     Boolean   @default(false)
  /// Sent in the chat after a reported sign-up, while the window is open.
  /// Null: no message, only the tag.
  signupMessage             String?
  tagOffered                String
  tagInterested             String
  tagSent                   String
  tagClicked                String
  /// Added when the landing page reports the sign-up. The editor and the API
  /// always set it; the empty default only covers rows the previous app writes
  /// while a deployment runs (an empty tag is never written to a contact).
  tagSignedUp               String    @default("")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactOffers ContactOffer[]

  @@index([workspaceId, position])
}

/// One offer to one contact: the "never twice" claim (R5), progress and funnel (R10).
model ContactOffer {
  id             String    @id @default(cuid())
  workspaceId    String
  contactId      String
  offerId        String
  /// Campaign whose link delivery started it; SetNull keeps history (R16).
  automationId   String?
  /// The trigger behind that delivery: the campaign plus the comment id, button-tap
  /// mid or DM mid. A campaign starts the next offer on every new trigger, so this
  /// key, not the campaign, keeps a redelivered webhook, a retried job or a repeated
  /// tap with the same mid from starting a second offer.
  startKey       String?
  /// Started 22 hours after the delivery (Automation.offerDelayHours), taken from the
  /// start job: no reminder follows. False for every offer started right away.
  lateStart      Boolean   @default(false)
  offeredAt      DateTime  @default(now())
  /// The last offer message (with the button) went out; anchors the reminder.
  pitchSentAt    DateTime?
  interestedAt   DateTime?
  /// mid of the tap that set interestedAt, to recognise a redelivered first tap.
  interestedMid  String?
  /// Card (or its fallback) or the reminder was delivered. A card after the
  /// reminder keeps this time.
  sentAt         DateTime?
  /// CARD | BUTTON | TEXT, null for a card in a form not known. REMINDER while only the
  /// reminder went out; the card replaces it, so later taps know the card is out.
  sentVia        String?
  reminderSentAt DateTime?
  clickedAt      DateTime?
  /// Set when the sequence stopped early.
  stoppedAt      DateTime?
  /// WINDOW_CLOSED | REJECTED | RATE_LIMITED | PLAN_LIMIT | OFFER_ARCHIVED | ACCOUNT_UNAVAILABLE
  stopReason     String?
  /// The personal code the landing page gets as ig= (lib/offers/signup-token.ts):
  /// random, 144 bits, URL-safe. Created on the first click while the offer
  /// reports sign-ups; it goes with the row, and so with the contact.
  signupToken         String?   @unique
  /// The landing page reported the sign-up (and the tag was added).
  signedUpAt          DateTime?
  /// The chat confirmation of the sign-up went out (or may have).
  signupMessageSentAt DateTime?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  offer      Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@unique([contactId, offerId])      // R5: never offer twice
  @@unique([contactId, startKey])     // one start per trigger (NULLs never collide)
  @@index([contactId, automationId])  // not unique: every new trigger may start an offer
  @@index([workspaceId, offerId])     // funnel groupBy
  @@index([automationId])             // SetNull on campaign delete
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}


enum InstagramProvider {
  META
  ZERNIO
}

/// Instagram Login (Business Login for Instagram) or Meta's Unified login.
enum MetaLogin {
  INSTAGRAM
  UNIFIED
}

model ZernioConnection {
  workspaceId    String @id
  apiKey         String
  profileId      String?
  webhookId      String?
  webhookSecret  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Claims persist independently of BullMQ retention so old taps never resend.
model PostbackDelivery {
  id String @id
  createdAt DateTime @default(now())
}
